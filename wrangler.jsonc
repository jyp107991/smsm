// The app: static assets served by Cloudflare Workers (DEPLOY §2), deployed by .github/workflows/deploy.yml.
// worker/index.ts runs only for /api/*: the smart features on Workers AI (binding AI, no key; S6a). SUPABASE_URL and
// SUPABASE_ANON_KEY (the public publishable key) are passed as vars at deploy time from the repository's variables.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smsm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  // S9: the second keep-alive. Once a day (05:37 UTC, an odd minute away from the other jobs) the scheduled handler
  // in worker/index.ts calls health() so the free Supabase project never pauses, even if GitHub's scheduled
  // workflows stop. `wrangler deploy` sends this list (it replaces the Worker's schedules).
  "triggers": { "crons": ["37 5 * * *"] },
  // The prompts are text files bundled with the Worker (worker/prompts/*.md).
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": false }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
